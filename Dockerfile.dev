FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci

# Copy config files (Tailwind is configured in CSS with @config)
COPY next.config.ts tsconfig.json postcss.config.mjs eslint.config.mjs ./

# Source files are mounted as volumes for hot reload
# COPY src ./src
# COPY public ./public

EXPOSE 6001

ENV PORT=6001
ENV HOSTNAME="0.0.0.0"

# Run in development mode (Turbopack with polling for Docker)
CMD ["npm", "run", "dev:docker"]
